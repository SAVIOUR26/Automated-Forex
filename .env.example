# NgaboPay Configuration
NODE_ENV=production
PORT=3000

# Session Secret (generate a random string)
SESSION_SECRET=change-me-to-random-string

# Dealer Login Credentials
DEALER_USERNAME=admin
DEALER_PASSWORD=change-me-secure-password

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id

# Exchange Rates (local currency per 1 USDT)
RATE_UGX=3750
RATE_KES=152
RATE_TZS=2530

# Fee percentage (e.g., 2 = 2%)
FEE_PERCENT=2

# Binance Monitor
MONITOR_INTERVAL_MS=10000
BINANCE_P2P_URL=https://p2p.binance.com/en/myOrder

# noVNC
NOVNC_PORT=6080
VNC_PORT=5900

# Android App API Key
ANDROID_API_KEY=change-me-android-key

# Domain
DOMAIN=ngabopay.online
