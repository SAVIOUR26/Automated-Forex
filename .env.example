# NgaboPay Configuration
NODE_ENV=production
PORT=3000

# Session Secret (generate a random string)
SESSION_SECRET=change-me-to-random-string

# Dealer Login Credentials
DEALER_USERNAME=admin
DEALER_PASSWORD=change-me-secure-password

# Telegram Bot (also configurable via Dashboard Settings)
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id

# Binance Monitor
MONITOR_INTERVAL_MS=10000
BINANCE_P2P_URL=https://www.binance.com/en/my/orders/p2p

# Default Currency (UGX, KES, TZS)
DEFAULT_CURRENCY=UGX

# Display for Playwright (Xvfb virtual display)
DISPLAY=:99

# noVNC
NOVNC_PORT=6080
VNC_PORT=5900

# Device API Key (used by modem engine to authenticate with NgaboPay)
DEVICE_API_KEY=change-me-to-random-string

# Domain
DOMAIN=ngabopay.online
