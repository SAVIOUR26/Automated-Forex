[Unit]
Description=NgaboPay USSD Engine
After=network.target modem-bridge.service
Wants=modem-bridge.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/Automated-Forex/modem-engine
ExecStart=/root/Automated-Forex/modem-engine/venv/bin/python main.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
