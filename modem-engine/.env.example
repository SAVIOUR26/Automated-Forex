# ─── NgaboPay Server ──────────────────────────────────────
# URL of the NgaboPay Node.js server (localhost if engine runs on the VPS)
NGABOPAY_URL=http://localhost:3000
# Must match DEVICE_API_KEY in the main NgaboPay .env
API_KEY=change-me-must-match-device-api-key

# ─── GSM Modem ────────────────────────────────────────────
# Serial port path — examples:
#   /dev/ttyUSB0      — USB modem plugged directly into VPS
#   /dev/ttyVMODEM    — Virtual serial port via socat (Tailscale bridge)
#   /dev/ttyACM0      — Some USB modems show up as ACM
MODEM_PORT=/dev/ttyUSB0
MODEM_BAUD=115200

# ─── Mobile Money ─────────────────────────────────────────
# Your mobile money PIN — stays on the VPS, never transmitted externally
MM_PIN=0000
USSD_PROVIDER=airtel_ug

# ─── Engine Server ────────────────────────────────────────
# Bind to localhost only (NOT 0.0.0.0) for security
ENGINE_HOST=127.0.0.1
ENGINE_PORT=7001
