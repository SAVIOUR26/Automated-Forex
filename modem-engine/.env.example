# ─── NgaboPay Server ──────────────────────────────────────
# Tailscale IP of the VPS, or localhost if engine runs on the VPS
NGABOPAY_URL=http://localhost:3000
API_KEY=your-android-api-key-here

# ─── GSM Modem ────────────────────────────────────────────
# Virtual serial port created by socat (VPS side)
MODEM_PORT=/dev/ttyVMODEM
MODEM_BAUD=115200

# ─── Mobile Money ─────────────────────────────────────────
# PIN stays on the VPS, never transmitted externally
MM_PIN=1234
USSD_PROVIDER=airtel_ug

# ─── Engine Server ────────────────────────────────────────
# Bind to Tailscale interface or localhost only (NOT 0.0.0.0)
ENGINE_HOST=127.0.0.1
ENGINE_PORT=7001
