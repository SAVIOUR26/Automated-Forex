# ─── NgaboPay Server ──────────────────────────────────────
# If engine runs on Windows laptop → use your public domain or VPS Tailscale IP
# If engine runs on the VPS itself → use http://localhost:3000
NGABOPAY_URL=https://ngabopay.online
# Must match DEVICE_API_KEY in the main NgaboPay .env
API_KEY=change-me-must-match-device-api-key

# ─── GSM Modem ────────────────────────────────────────────
# Serial port path:
#   Windows:  COM3, COM4, etc. (check Device Manager → Ports)
#   Linux:    /dev/ttyUSB0, /dev/ttyACM0, /dev/ttyVMODEM
MODEM_PORT=COM3
MODEM_BAUD=115200

# ─── Mobile Money ─────────────────────────────────────────
# Your mobile money PIN — stored locally, never sent over the network
MM_PIN=0000
USSD_PROVIDER=airtel_ug

# ─── Engine Server ────────────────────────────────────────
# Windows laptop: use 0.0.0.0 so VPS can reach via Tailscale
# VPS (local):    use 127.0.0.1 for security
ENGINE_HOST=0.0.0.0
ENGINE_PORT=7001
